# Copy thành prod.env rồi sửa giá trị. TUYỆT ĐỐI không commit prod.env.
# - Lưu file với line ending LF (VS Code: góc dưới bên phải bấm CRLF -> chọn LF)
# - Mật khẩu chỉ dùng chữ + số (tránh ký tự đặc biệt gây lỗi khi truyền qua shell)
DB_NAME=ecommerce_db
DB_USER=ecommerce
DB_PASS=DOI_MAT_KHAU_DB
DB_ROOT_PASSWORD=DOI_MAT_KHAU_ROOT
SESSION_SECRET=DOI_CHUOI_NGAU_NHIEN_DAI

# Vercel + Render PostgreSQL: configure these as Vercel Production variables.
# Use Render's external database URL (not the internal URL) for DATABASE_URL or DB_URL.

# DB_DIALECT=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# DB_SSL=true
# Default accounts are not created in production unless explicitly enabled.
# SEED_DEFAULT_ACCOUNTS=false
