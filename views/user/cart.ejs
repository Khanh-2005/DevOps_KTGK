<%- include('./partials/header') %>

<div class="container my-5">
  <div class="row">
    <div class="col-12">
      <h2 class="mb-4">Shopping Cart</h2>

      <% if (cartItems && cartItems.length > 0) { %>
      <div class="row">
        <!-- Cart Items -->
        <div class="col-md-8">
          <div class="card shadow-sm">
            <div class="card-body">
              <% cartItems.forEach(function(item) { %> <% if (item.product) { %>
              <div class="row mb-4 cart-item">
                <div class="col-md-3">
                  <img
                    src="<%= item.product.image || '/images/default-product.jpg' %>"
                    class="img-fluid rounded"
                    alt="<%= item.product.name %>"
                  />
                </div>
                <div class="col-md-9">
                  <div class="d-flex justify-content-between align-items-start">
                    <h5 class="mb-2"><%= item.product.name %></h5>
                    <button
                      class="btn btn-sm btn-outline-danger"
                      onclick="removeFromCart('<%= item.product.id %>')"
                    >
                      <i class="fas fa-trash"></i>
                    </button>
                  </div>
                  <p class="text-muted mb-2">
                    Price: $<%= item.product.price %>
                  </p>
                  <div class="d-flex align-items-center">
                    <div class="input-group" style="width: 130px">
                      <button
                        class="btn btn-outline-secondary"
                        onclick="updateQuantity('<%= item.product.id %>', -1)"
                      >
                        -
                      </button>
                      <input
                        type="number"
                        class="form-control text-center"
                        value="<%= item.quantity %>"
                        min="1"
                        onchange="updateQuantity('<%= item.product.id %>', this.value)"
                      />
                      <button
                        class="btn btn-outline-secondary"
                        onclick="updateQuantity('<%= item.product.id %>', 1)"
                      >
                        +
                      </button>
                    </div>
                    <span class="ms-3">
                      Total: $<%= (item.product.price *
                      item.quantity).toFixed(2) %>
                    </span>
                  </div>
                </div>
              </div>
              <% } %> <% }); %>
            </div>
          </div>
        </div>

        <!-- Order Summary -->
        <div class="col-md-4">
          <div class="card shadow-sm">
            <div class="card-body">
              <h5 class="card-title mb-4">Order Summary</h5>
              <div class="d-flex justify-content-between mb-2">
                <span>Subtotal</span>
                <span>$<%= total.toFixed(2) %></span>
              </div>
              <div class="d-flex justify-content-between mb-2">
                <span>Shipping</span>
                <span>Free</span>
              </div>
              <hr />
              <div class="d-flex justify-content-between mb-4">
                <strong>Total</strong>
                <strong>$<%= total.toFixed(2) %></strong>
              </div>
              <button class="btn btn-primary w-100" onclick="checkout()">
                Proceed to Checkout
              </button>
            </div>
          </div>
        </div>
      </div>
      <% } else { %>
      <div class="text-center py-5">
        <div class="empty-cart-container">
          <i class="fas fa-shopping-cart fa-4x text-muted mb-4"></i>
          <h4 class="mb-3">Your cart is empty</h4>
          <p class="text-muted mb-4">
            Looks like you haven't added any items to your cart yet.
          </p>
          <a href="/" class="btn btn-primary btn-lg">
            <i class="fas fa-shopping-bag me-2"></i>Start Shopping
          </a>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</div>

<style>
  .empty-cart-container {
    padding: 40px;
    background: #f8f9fa;
    border-radius: 8px;
    max-width: 600px;
    margin: 0 auto;
  }

  .cart-item {
    border-bottom: 1px solid #eee;
    padding-bottom: 20px;
    margin-bottom: 20px;
  }

  .cart-item:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .cart-item img {
    width: 100%;
    height: 100px;
    object-fit: contain;
    background-color: #f8f9fa;
  }

  .input-group .btn {
    z-index: 0;
  }

  .input-group input[type="number"] {
    text-align: center;
  }

  .input-group input[type="number"]::-webkit-inner-spin-button,
  .input-group input[type="number"]::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
</style>

<script>
  async function updateQuantity(productId, change) {
    try {
      let newQuantity;
      if (typeof change === "number") {
        const input = event.target.parentElement.querySelector("input");
        newQuantity = parseInt(input.value) + change;
      } else {
        newQuantity = parseInt(change);
      }

      if (newQuantity < 1) return;

      const response = await fetch(`/cart/update/${productId}`, {
        method: "PUT",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ quantity: newQuantity }),
      });

      if (response.ok) {
        location.reload();
      } else {
        throw new Error("Failed to update cart");
      }
    } catch (error) {
      console.error("Error:", error);
      alert("Failed to update quantity");
    }
  }

  async function removeFromCart(productId) {
    if (confirm("Are you sure you want to remove this item?")) {
      try {
        const response = await fetch(`/cart/remove/${productId}`, {
          method: "DELETE",
        });

        if (response.ok) {
          location.reload();
        } else {
          throw new Error("Failed to remove item");
        }
      } catch (error) {
        console.error("Error:", error);
        alert("Failed to remove item");
      }
    }
  }

  function checkout() {
    window.location.href = "/cart/checkout";
  }
</script>

<%- include('./partials/footer') %>
