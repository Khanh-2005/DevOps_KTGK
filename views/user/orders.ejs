<%- include('./partials/header') %>

<div class="container my-5">
  <div class="card shadow-sm">
    <div class="card-body">
      <h3 class="mb-4">My Orders</h3>

      <% if (orders && orders.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover">
          <thead>
            <tr>
              <th>Order ID</th>
              <th>Date</th>
              <th>Items</th>
              <th>Total</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% orders.forEach(function(order) { %>
            <tr>
              <% const statusClass = ({ pending: 'primary', processing: 'warning', shipped: 'info',
                delivered: 'success', cancelled: 'danger' })[String(order.status).toLowerCase()] || 'secondary'; %>
              <td>#<%= order.id %></td>
              <td><%= moment(order.createdAt).format('MMM D, YYYY') %></td>
              <td><%= order.items.length %> items</td>
              <td>$<%= parseFloat(order.totalAmount).toFixed(2) %></td>
              <td>
                <span
                  class="badge bg-<%= statusClass %>"
                >
                  <%= order.status.toUpperCase() %>
                </span>
              </td>
              <td>
                <a
                  href="/orders/<%= order.id %>"
                  class="btn btn-sm btn-outline-primary"
                >
                  View Details
                </a>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <div class="text-center py-5">
        <div class="empty-orders">
          <i class="fas fa-shopping-bag fa-4x text-muted mb-4"></i>
          <h4 class="mb-3">No orders yet</h4>
          <p class="text-muted mb-4">You haven't placed any orders yet.</p>
          <a href="/" class="btn btn-primary"> Start Shopping </a>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</div>

<style>
  .empty-orders {
    padding: 40px;
    background: #f8f9fa;
    border-radius: 8px;
    max-width: 600px;
    margin: 0 auto;
  }

  .table th {
    font-weight: 600;
    background-color: #f8f9fa;
  }

  .badge {
    padding: 8px 12px;
    font-weight: 500;
  }

  .table td {
    vertical-align: middle;
  }

  .btn-outline-primary {
    border-width: 1px;
  }

  .btn-outline-primary:hover {
    background-color: #0d6efd;
    color: white;
  }

  @media (max-width: 768px) {
    .table-responsive {
      border: 0;
    }

    .table thead {
      display: none;
    }

    .table tr {
      display: block;
      margin-bottom: 1rem;
      border: 1px solid #dee2e6;
      border-radius: 0.25rem;
    }

    .table td {
      display: block;
      text-align: right;
      padding: 0.75rem;
      border-bottom: 1px solid #dee2e6;
    }

    .table td:last-child {
      border-bottom: 0;
    }

    .table td::before {
      content: attr(data-label);
      float: left;
      font-weight: bold;
    }
  }
</style>

<%- include('./partials/footer') %>
