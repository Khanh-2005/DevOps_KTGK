<%- include('./partials/header') %>

  <div class="container my-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
        <li class="breadcrumb-item"><a href="/products" class="text-decoration-none">Products</a></li>
        <% if (product.category) { %>
          <li class="breadcrumb-item">
            <a href="/category/<%= product.category.id %>" class="text-decoration-none">
              <%= product.category.name %>
            </a>
          </li>
          <% } %>
            <li class="breadcrumb-item active text-truncate" style="max-width: 300px;" aria-current="page">
              <%= product.name %>
            </li>
      </ol>
    </nav>

    <!-- Main Product Detail Section -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-5">
      <div class="card-body p-4 p-lg-5">
        <div class="row g-4 g-lg-5">
          <!-- Product Image Column -->
          <div class="col-lg-5">
            <div class="position-relative bg-light rounded-4 overflow-hidden text-center p-3 border">
              <img src="<%= product.image || '/images/default-product.jpg' %>" alt="<%= product.name %>"
                class="img-fluid rounded-3 product-main-img" id="mainProductImage" />
              <% if (product.stock> 10) { %>
                <span class="badge bg-success position-absolute top-0 start-0 m-3 px-3 py-2 fs-6">
                  <i class="fas fa-check-circle me-1"></i> In Stock (<%= product.stock %>
                    <%= product.unit || 'items' %>)
                </span>
                <% } else if (product.stock> 0) { %>
                  <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-3 px-3 py-2 fs-6">
                    <i class="fas fa-exclamation-triangle me-1"></i> Low Stock (<%= product.stock %>
                      <%= product.unit || 'items' %> left)
                  </span>
                  <% } else { %>
                    <span class="badge bg-danger position-absolute top-0 start-0 m-3 px-3 py-2 fs-6">
                      <i class="fas fa-times-circle me-1"></i> Out of Stock
                    </span>
                    <% } %>
            </div>

            <!-- Quick Highlights Under Image -->
            <div class="row g-2 mt-3 text-center text-muted small">
              <div class="col-4">
                <div class="p-2 border rounded-3 bg-light">
                  <i class="fas fa-truck text-primary mb-1 d-block"></i>
                  <span>Fast Delivery</span>
                </div>
              </div>
              <div class="col-4">
                <div class="p-2 border rounded-3 bg-light">
                  <i class="fas fa-shield-alt text-primary mb-1 d-block"></i>
                  <span>100% Genuine</span>
                </div>
              </div>
              <div class="col-4">
                <div class="p-2 border rounded-3 bg-light">
                  <i class="fas fa-undo text-primary mb-1 d-block"></i>
                  <span>7-Day Return</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Product Information Column -->
          <div class="col-lg-7 d-flex flex-column">
            <!-- Category Badge -->
            <% if (product.category) { %>
              <div class="mb-2">
                <a href="/category/<%= product.category.id %>"
                  class="badge bg-primary bg-opacity-10 text-primary text-decoration-none px-3 py-2 rounded-pill">
                  <i class="fas fa-tag me-1"></i>
                  <%= product.category.name %>
                </a>
              </div>
              <% } %>

                <h2 class="fw-bold mb-3">
                  <%= product.name %>
                </h2>

                <!-- Price Display -->
                <div class="d-flex align-items-center gap-3 mb-3 p-3 bg-light rounded-3">
                  <span class="fs-2 fw-bold text-primary">$<%= product.price %></span>
                  <% if (product.unit) { %>
                    <span class="text-muted">/ <%= product.unit %></span>
                    <% } %>
                </div>

                <!-- Description -->
                <div class="mb-4">
                  <h6 class="fw-semibold text-dark">Description:</h6>
                  <p class="text-muted lh-base">
                    <%= product.description || 'No detailed description available for this product.' %>
                  </p>
                </div>

                <!-- Quantity Selector & Actions -->
                <% if (product.stock> 0) { %>
                  <div class="mb-4">
                    <label class="form-label fw-semibold">Quantity:</label>
                    <div class="d-flex align-items-center gap-3">
                      <div class="input-group" style="max-width: 140px;">
                        <button class="btn btn-outline-secondary" type="button" onclick="changeQty(-1)">
                          <i class="fas fa-minus"></i>
                        </button>
                        <input type="number" id="quantityInput" class="form-control text-center font-monospace fw-bold"
                          value="1" min="1" max="<%= product.stock %>" readonly />
                        <button class="btn btn-outline-secondary" type="button" onclick="changeQty(1)">
                          <i class="fas fa-plus"></i>
                        </button>
                      </div>
                      <span class="text-muted small">
                        Available: <strong>
                          <%= product.stock %>
                        </strong>
                        <%= product.unit || 'units' %>
                      </span>
                    </div>
                  </div>

                  <!-- Action Buttons -->
                  <div class="d-flex gap-3 mb-4">
                    <button class="btn btn-primary btn-lg flex-fill py-3 shadow-sm"
                      onclick="addCurrentProductToCart(false)">
                      <i class="fas fa-cart-plus me-2"></i>Add to Cart
                    </button>
                    <button class="btn btn-outline-primary btn-lg flex-fill py-3 shadow-sm"
                      onclick="addCurrentProductToCart(true)">
                      <i class="fas fa-bolt me-2"></i>Buy Now
                    </button>
                  </div>
                  <% } else { %>
                    <div class="alert alert-danger mb-4">
                      <i class="fas fa-exclamation-circle me-2"></i>This product is currently out of stock. Please check
                      back later.
                    </div>
                    <% } %>

                      <hr class="my-4" />

                      <!-- Specifications Summary Table -->
                      <div>
                        <h5 class="fw-bold mb-3 text-dark">
                          <i class="fas fa-info-circle me-2 text-primary"></i>Specifications
                        </h5>
                        <div class="table-responsive">
                          <table class="table table-bordered table-striped mb-0 small">
                            <tbody>
                              <% if (product.manufacturer) { %>
                                <tr>
                                  <th class="w-25 text-muted">Manufacturer</th>
                                  <td class="fw-semibold">
                                    <%= product.manufacturer %>
                                  </td>
                                </tr>
                                <% } %>
                                  <% if (product.origin) { %>
                                    <tr>
                                      <th class="w-25 text-muted">Origin / Country</th>
                                      <td class="fw-semibold">
                                        <%= product.origin %>
                                      </td>
                                    </tr>
                                    <% } %>
                                      <% if (product.barcode) { %>
                                        <tr>
                                          <th class="w-25 text-muted">Barcode (EAN)</th>
                                          <td class="font-monospace">
                                            <%= product.barcode %>
                                          </td>
                                        </tr>
                                        <% } %>
                                          <% if (product.unit) { %>
                                            <tr>
                                              <th class="w-25 text-muted">Unit</th>
                                              <td>
                                                <%= product.unit %>
                                              </td>
                                            </tr>
                                            <% } %>
                                              <% if (product.manufacturingDate) { %>
                                                <tr>
                                                  <th class="w-25 text-muted">Manufacturing Date</th>
                                                  <td>
                                                    <%= moment(product.manufacturingDate).format('DD/MM/YYYY') %>
                                                  </td>
                                                </tr>
                                                <% } %>
                                                  <% if (product.expiryDate) { %>
                                                    <tr>
                                                      <th class="w-25 text-muted">Expiry Date</th>
                                                      <td>
                                                        <%= moment(product.expiryDate).format('DD/MM/YYYY') %>
                                                      </td>
                                                    </tr>
                                                    <% } %>
                            </tbody>
                          </table>
                        </div>
                      </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Related Products Section -->
    <% if (relatedProducts && relatedProducts.length> 0) { %>
      <div class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h3 class="fw-bold mb-0">Related Products</h3>
          <% if (product.category) { %>
            <a href="/category/<%= product.category.id %>" class="btn btn-outline-primary btn-sm">
              View All in <%= product.category.name %> <i class="fas fa-arrow-right ms-1"></i>
            </a>
            <% } %>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
          <% relatedProducts.forEach(function(rel) { %>
            <div class="col">
              <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden product-card">
                <a href="/product/<%= rel.id %>" class="related-img-wrapper">
                  <img src="<%= rel.image || '/images/default-product.jpg' %>" class="card-img-top related-img"
                    alt="<%= rel.name %>" />
                </a>
                <div class="card-body d-flex flex-column p-3">
                  <h6 class="card-title fw-bold mb-2">
                    <a href="/product/<%= rel.id %>" class="text-decoration-none text-dark">
                      <%= rel.name %>
                    </a>
                  </h6>
                  <div class="mt-auto d-flex justify-content-between align-items-center">
                    <span class="fs-6 fw-bold text-primary">$<%= rel.price %></span>
                    <a href="/product/<%= rel.id %>" class="btn btn-outline-primary btn-sm">
                      Details
                    </a>
                  </div>
                </div>
              </div>
            </div>
            <% }); %>
        </div>
      </div>
      <% } %>
  </div>

  <style>
    .product-main-img {
      max-height: 420px;
      object-fit: contain;
      width: 100%;
    }

    .related-img-wrapper {
      height: 180px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f8f9fa;
      overflow: hidden;
    }

    .related-img {
      height: 100%;
      width: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
    }

    .product-card:hover .related-img {
      transform: scale(1.05);
    }

    .product-card {
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .product-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1) !important;
    }
  </style>

  <script>
    function changeQty(delta) {
      const input = document.getElementById("quantityInput");
      if (!input) return;
      let val = parseInt(input.value) + delta;
      const min = parseInt(input.min) || 1;
      const max = parseInt(input.max) || 999;
      if (val < min) val = min;
      if (val > max) val = max;
      input.value = val;
    }

    async function addCurrentProductToCart(redirectToCheckout) {
      const qtyInput = document.getElementById("quantityInput");
      const quantity = qtyInput ? parseInt(qtyInput.value) || 1 : 1;
      const productId = "<%= product.id %>";

      try {
        const response = await fetch(`/cart/add/${productId}`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ quantity }),
        });

        const data = await response.json();

        if (response.ok) {
          if (redirectToCheckout) {
            window.location.href = "/checkout";
            return;
          }

          // Cập nhật số lượng trên icon cart
          const cartBadge = document.querySelector(".fa-shopping-cart + .badge, .cart-badge");
          if (cartBadge) {
            cartBadge.textContent = data.cartCount;
          }

          // Toast thông báo
          const toast = document.createElement("div");
          toast.className = "toast-notification success";
          toast.innerHTML = `
          <i class="fas fa-check-circle"></i>
          Added ${quantity} item(s) to cart successfully!
        `;
          document.body.appendChild(toast);
          setTimeout(() => toast.remove(), 3000);
        } else {
          alert(data.message || "Failed to add product to cart");
        }
      } catch (err) {
        console.error(err);
        alert("An error occurred while adding to cart.");
      }
    }
  </script>

  <%- include('./partials/footer') %>