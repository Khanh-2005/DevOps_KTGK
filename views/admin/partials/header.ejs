<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Admin Dashboard</title>
  <link rel="stylesheet" href="/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />
  <style>
    .admin-header {
      min-height: 50px;
      background: #fff;
      box-shadow: 0 1px 5px rgb(0 0 0 / 8%);
    }

    .admin-header .nav-link,
    .admin-header .icon-button {
      color: #53657d;
    }

    .admin-header .nav-link:hover,
    .admin-header .icon-button:hover {
      color: #1b2a4e;
    }

    .admin-header .icon-button {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 40px;
      min-height: 40px;
      border: 0;
      background: transparent;
      font-size: 1.1rem;
      text-decoration: none;
    }

    .admin-header .admin-avatar {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: #e9ecef;
      color: #53657d;
      font-size: 1.35rem;
    }

    .admin-sidebar-backdrop {
      position: fixed;
      z-index: 1030;
      inset: 50px 0 0;
      background: rgb(0 0 0 / 35%);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.2s ease, visibility 0.2s ease;
    }

    .admin-sidebar {
      position: fixed;
      z-index: 1031;
      top: 50px;
      bottom: 0;
      left: 0;
      width: min(280px, 85vw);
      padding: 1rem;
      overflow-y: auto;
      background: #fff;
      box-shadow: 2px 0 12px rgb(0 0 0 / 12%);
      transform: translateX(-105%);
      visibility: hidden;
      transition: transform 0.2s ease, visibility 0.2s ease;
    }

    .admin-sidebar .nav-link {
      padding: 0.75rem 1rem;
      border-radius: 0.375rem;
      color: #53657d;
    }

    .admin-sidebar .nav-link:hover,
    .admin-sidebar .nav-link.active {
      background: #eef2f8;
      color: #1b2a4e;
    }

    .admin-sidebar .nav-link.text-danger {
      color: #dc3545 !important;
    }

    .admin-sidebar-open {
      overflow: hidden;
    }

    .admin-sidebar-open .admin-sidebar-backdrop {
      opacity: 1;
      visibility: visible;
    }

    .admin-sidebar-open .admin-sidebar {
      transform: translateX(0);
      visibility: visible;
    }

    @media (max-width: 575.98px) {
      .admin-header .admin-user-name {
        display: none;
      }
    }

    .admin-sidebar-collapsed .sidebar {
      display: none !important;
    }

    .admin-sidebar-collapsed .sidebar+.col-md-9 {
      flex: 0 0 100%;
      max-width: 100%;
      margin-left: 0 !important;
    }
  </style>
</head>

<body>
  <header class="admin-header">
    <nav class="navbar navbar-expand navbar-light py-1">
      <div class="container-fluid px-3 px-lg-4">
        <div class="d-flex align-items-center">
          <button class="icon-button" id="adminSidebarToggle" type="button" aria-label="Toggle admin sidebar"
            aria-controls="adminSidebar" aria-expanded="false">
            <i class="bi bi-list"></i>
          </button>
          <ul class="navbar-nav flex-row ms-3">
            <li class="nav-item">
              <a class="nav-link px-3" href="/admin/dashboard">Home</a>
            </li>
          </ul>
        </div>

        <div class="d-flex align-items-center ms-auto">
          <span class="icon-button" aria-hidden="true">
            <i class="bi bi-chat-left-text"></i>
          </span>
          <span class="icon-button" aria-hidden="true">
            <i class="bi bi-bell"></i>
          </span>
          <button class="icon-button" id="adminFullscreenToggle" type="button" aria-label="Toggle fullscreen">
            <i class="bi bi-arrows-fullscreen"></i>
          </button>
          <div class="d-flex align-items-center ms-2 ms-lg-3">
            <span class="admin-avatar" aria-hidden="true">
              <i class="bi bi-person-fill"></i>
            </span>
            <span class="admin-user-name ms-2">
              <%= typeof user !=='undefined' && user && user.username ? user.username : 'Admin' %>
            </span>
          </div>
        </div>
      </div>
    </nav>
  </header>

  <%- include('./sidebar') %>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const sidebarToggle = document.getElementById("adminSidebarToggle");
      const fullscreenToggle = document.getElementById("adminFullscreenToggle");
      const sidebarBackdrop = document.getElementById("adminSidebarBackdrop");
      const sidebarClose = document.getElementById("adminSidebarClose");

      function setSidebarOpen(isOpen) {
        document.body.classList.toggle("admin-sidebar-open", isOpen);
        sidebarToggle.setAttribute("aria-expanded", String(isOpen));
        document.getElementById("adminSidebar").setAttribute("aria-hidden", String(!isOpen));
      }

      sidebarToggle.addEventListener("click", function () {
        setSidebarOpen(sidebarToggle.getAttribute("aria-expanded") !== "true");
      });

      sidebarBackdrop.addEventListener("click", function () {
        setSidebarOpen(false);
      });

      sidebarClose.addEventListener("click", function () {
        setSidebarOpen(false);
      });

      document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
          setSidebarOpen(false);
        }
      });

      fullscreenToggle.addEventListener("click", function () {
        if (document.fullscreenElement) {
          document.exitFullscreen();
        } else {
          document.documentElement.requestFullscreen();
        }
      });
    });
  </script>