          <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Products List</h6>
            <div class="d-flex gap-2">
              <!-- Search Box -->
              <div class="search-box" style="min-width: 300px">
